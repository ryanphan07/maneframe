# Copy to backend/.env and adjust. Every value shown is the default.

# LLM (OpenAI-compatible server, e.g. llama-server with --mmproj)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=local-key
LLM_MODEL=local
# Seconds per call (one call per window)
LLM_TIMEOUT=300
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS=500
# Constrained output: send a JSON schema (seen + quips) as response_format; set false if your server rejects it
LLM_JSON_SCHEMA=true
LLM_TEMPERATURE=0.8
# Read by start.ps1 only, to start llama-server when nothing answers at LLM_BASE_URL (empty path: llama-server from PATH)
# LLAMA_SERVER_PATH=C:/AI/models/llama-b10679-bin-win-vulkan-x64/llama-server.exe
# LLM_MODEL_PATH=C:/AI/models/Qwen3.6-35B-A3B-UD-Q3_K_XL.gguf
# LLM_MMPROJ_PATH=C:/AI/models/mmproj-Qwen3.6-35B-F16.gguf
# llama-server -c; the prompts need about 3600 tokens per call
LLM_CTX=8192

# Vision windowing: one LLM call per window of frames
WINDOW_SECONDS=10
FRAMES_PER_WINDOW=6
FRAME_WIDTH=896
MAX_QUIPS_PER_WINDOW=3
MIN_QUIP_GAP_SEC=4.5

# Text to speech. TTS_ENGINE=edge (default) needs internet; piper runs offline on the CPU (README: Offline voice)
TTS_ENGINE=edge
PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx
PIPER_LENGTH_SCALE=0.9
TTS_VOICE=en-US-GuyNeural
TTS_RATE=+10%
TTS_ENABLED=true
TTS_TIMEOUT_SECONDS=30
# Clips synthesized at once (1 = one after another; raise only if edge-tts stays reliable) and the minimum gap between clip starts
TTS_CONCURRENCY=1
TTS_START_STAGGER_SECONDS=0.3
# Extra tries after a transient failure (timeout, dropped connection, "No audio was received"; never 401/403) and the wait before each
TTS_RETRIES=1
TTS_RETRY_DELAY_SECONDS=1.0
# Max seconds a quip may be pushed later to avoid overlapping the previous audio; otherwise it is dropped
MAX_SHIFT_SEC=2.0

# mp4 export: path to an ffmpeg executable (empty = the binary bundled with imageio-ffmpeg) and the render time limit in seconds
FFMPEG_PATH=
EXPORT_TIMEOUT_SECONDS=1800
# Hard cap on converting an upload (HEVC / rotated phone clips) to H.264. The conversion reports progress while ffmpeg
# advances, which keeps JOB_STALE_SECONDS from failing the job; a hung ffmpeg stops reporting and is failed after
# JOB_STALE_SECONDS. Keep this above JOB_STALE_SECONDS so the stale check, not this limit, ends a hang.
TRANSCODE_TIMEOUT_SECONDS=3600

# Server
LOG_LEVEL=INFO
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Base URL used to build audio_url links returned to the client
PUBLIC_BASE_URL=http://localhost:8000
# Root folder for videos/ and audio/ (default: backend/uploads)
# UPLOAD_DIR=C:/path/to/uploads

# Limits and cleanup
MAX_VIDEO_SECONDS=1800
MAX_UPLOAD_MB=2048
JOB_STALE_SECONDS=1800
JOB_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=600
